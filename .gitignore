# L50-L57: real datasets for the 5 new steering targets are small enough to commit
# directly (~19M for aggregation/binding/catalytic/disorder/expression combined) --
# this is the actual evidence behind each L5X doc's results, not bulk training data.
# EXCEPT the unused raw parquets in binding/ (only RASK_HUMAN is actually read by
# l53_run_repro.py) and immunogenicity/mhcii_el.csv (679M, downloaded but never read
# by l56_immunogenicity_proxy_validation.py -- see that module's docstring, Tier 2).
src/l38/data_cache/binding/B2L11_HUMAN_Dutta_2010_binding-Mcl-1.parquet
src/l38/data_cache/binding/CCR5_HUMAN_Gill_2023.parquet
src/l38/data_cache/binding/DLG4_RAT_McLaughlin_2012.parquet
src/l38/data_cache/binding/Q53Z42_HUMAN_McShan_2019_binding-TAPBPR.parquet
src/l38/data_cache/binding/SPG1_STRSG_Olson_2014.parquet
src/l38/data_cache/binding/SPIKE_SARS2_Starr_2020_binding.parquet
src/l38/data_cache/immunogenicity/mhcii_el.csv
# Same pattern: AMIE/OXDA were the single-backbone-DMS catalytic candidates L54
# considered and rejected in favor of DLKcat's cross-protein spread (see
# l54_catalytic_activity_steering.py's docstring) -- l54_run_repro.py never reads
# them, only dlkcat_wt_mut.json.
src/l38/data_cache/catalytic/AMIE_PSEAE_Wrenbeck_2017.parquet
src/l38/data_cache/catalytic/OXDA_RHOTO_Vanella_2023_activity.parquet
# The one large immunogenicity file actually used (iedb_tcell_mhcii.json, 53M) is
# committed gzip-compressed instead (3M) -- see load_tcell_records() in
# l56_immunogenicity_proxy_validation.py, which reads the .gz transparently.
src/l38/data_cache/immunogenicity/iedb_tcell_mhcii.json
src/l38/data_cache/immunogenicity/iedb_antigens.json
src/l38/data_cache/immunogenicity/nonallergen.fasta
src/l38/data_cache/immunogenicity/allergen.fasta
src/l38/data_cache/immunogenicity/iedb_labels.json
src/l38/data_cache/immunogenicity/antigen_posfrac.csv
